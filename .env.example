# Firebase web client config. Copy this file to .env.local and fill in real
# values from Firebase Console -> Project Settings -> Your apps -> Web app.
#
# These VITE_* vars are inlined into the production bundle at build time, so
# they end up visible in the deployed JS. That's fine for Firebase web keys
# (they're public-by-design), but lock the key down with HTTP-referrer
# restrictions in Google Cloud Console -> APIs & Services -> Credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
